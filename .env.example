HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — SQLite locally (the default, nothing to set). Production uses
# MySQL 8: uncomment and fill in.
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# Email (Gmail/Google Workspace SMTP) — see .env's own comment for how to
# generate SMTP_PASSWORD (a Google App Password, not the real login one).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_TO=

# Production only — public address of this CMS, and the sites allowed to
# call its API (comma-separated). Leave unset locally.
# PUBLIC_URL=https://cms.pixelwave.it
# CORS_ORIGINS=https://pixelwave.it,https://www.pixelwave.it
